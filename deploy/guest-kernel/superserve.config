# Guest features sandboxes rely on, layered over Firecracker's 6.1 CI configs.
# FUSE-based filesystem mounts.
CONFIG_FUSE_FS=y
# VPN clients and rootless container networking need /dev/net/tun.
CONFIG_TUN=y
# seccomp filters (browsers, container runtimes) run JIT-compiled; the JIT
# requires module support. No modules are shipped.
CONFIG_MODULES=y
CONFIG_BPF_JIT=y
# Every exec moves its process into the workload freezer cgroup. Since 6.0 each
# such move waits out an RCU grace period unless this is set.
CONFIG_CGROUP_FAVOR_DYNMODS=y
# Docker with either iptables backend.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_IP_VS=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NF_CT_NETLINK=y
